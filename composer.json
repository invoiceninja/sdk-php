{
    "name": "invoiceninja/sdk-php",
    "description": "The Invoice Ninja v5 PHP SDK",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "David Bomba",
            "email": "turbo124@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {"InvoiceNinja\\Sdk\\": "src/"}
    },
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.16.1 || ^8.3.1",
        "nesbot/carbon": "^3.15.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.16",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^11",
        "vlucas/phpdotenv": "^5.8"
    },
    "autoload-dev": {
        "psr-4": {
            "InvoiceNinja\\Sdk\\Tests\\": "tests"
        }
    },
    "scripts": {
        "phpstan": "phpstan analyse --memory-limit=512M",
        "test-api": "@php tests/check-api.php",
        "test": [
            "@test-api",
            "@php vendor/bin/phpunit --testsuite Unit"
        ],
        "test-unit": "@php vendor/bin/phpunit --testsuite Unit",
        "test-integration": [
            "@php tests/check-integration-opt-in.php",
            "@test-api",
            "@php vendor/bin/phpunit --testsuite Integration"
        ],
        "test-coverage": [
            "@test --coverage-text --coverage-html coverage/html --coverage-clover coverage/clover.xml",
            "@php tests/check-coverage.php coverage/clover.xml"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
