<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
         defaultTestSuite="Unit"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         failOnDeprecation="true"
         failOnPhpunitDeprecation="true"
         failOnNotice="true"
         failOnSkipped="true"
         stopOnFailure="true"
         failOnIncomplete="true">
  <testsuites>
    <testsuite name="Unit">
      <file>tests/BootTest.php</file>
      <directory>tests/Invoice</directory>
      <directory>tests/Unit</directory>
    </testsuite>
    <testsuite name="Integration">
      <directory>tests</directory>
      <exclude>tests/BootTest.php</exclude>
      <!-- Directory separators prevent PHPUnit 11 from also excluding InvoicesTest.php. -->
      <exclude>tests/Invoice/</exclude>
      <exclude>tests/Unit/</exclude>
    </testsuite>
  </testsuites>
  <source>
    <include>
      <directory suffix=".php">src</directory>
    </include>
  </source>
  <php>
    <ini name="error_reporting" value="-1"/>
  </php>
</phpunit>
